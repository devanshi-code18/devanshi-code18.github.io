---
import Base from '../layouts/Base.astro';
import { getPosts } from '../lib/posts.js';
import { getMergedPRs, repoName, allMergedUrl } from '../lib/oss.js';

const posts = await getPosts();
const prs = (await getMergedPRs()).slice(0, 8);

// Group posts by topic, newest topic first; posts without a topic go under "Posts".
const groups = [];
for (const p of posts) {
  const name = p.data.topic || 'Posts';
  let g = groups.find((x) => x.name === name);
  if (!g) groups.push((g = { name, posts: [] }));
  g.posts.push(p);
}

const REPO_STYLE = {
  'vllm-project/vllm': 'vllm',
  'vllm-project/humming': 'vllm',
  'vllm-project/flash-attention': 'flash',
  'Dao-AILab/flash-attention': 'flash',
  'pytorch/ao': 'torch',
};
---
<Base variant="home">
  <div class="container">
    <div class="panel">
      {groups.length === 0 && (
        <>
          <h2>Posts</h2>
          <div class="cards">
            <div class="card card-empty">
              <div class="cover cover-text"><span>First post coming soon</span></div>
              <h3>Follow along by <a href="/rss.xml">RSS</a></h3>
            </div>
          </div>
        </>
      )}
      {groups.map((g) => (
        <>
          <h2>{g.name}</h2>
          <div class="cards">
            {g.posts.map((p) => (
              <a class="card" href={`/posts/${p.id}/`}>
                {p.data.cover
                  ? <img class="cover" src={p.data.cover} alt="" loading="lazy" />
                  : <div class="cover cover-text">{p.data.description && <span>{p.data.description}</span>}</div>}
                <h3>{p.data.title}{p.data.draft && <span class="badge">draft</span>}</h3>
              </a>
            ))}
          </div>
        </>
      ))}

      <h2>Open source</h2>
      <div class="cards">
        {prs.map((pr) => (
          <a class="card" href={pr.url}>
            <div class={`cover cover-repo repo-${REPO_STYLE[pr.repo] || 'other'}`}>
              <span class="cover-repo-name">{repoName(pr.repo)}</span>
              <span class="cover-repo-num">#{pr.number}</span>
            </div>
            <h3>{pr.title}</h3>
            <h4>On {repoName(pr.repo)}</h4>
          </a>
        ))}
      </div>
      <p class="more"><a href={allMergedUrl()}>All merged pull requests →</a></p>
    </div>
  </div>
</Base>
