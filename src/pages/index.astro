---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
import { allMergedUrl } from '../lib/oss.js';
---
<Base home>
  <section class="hero">
    <h1>{SITE.headline}</h1>
    <img class="hero-art" src="/images/ink/hero.png" alt="A stick figure cranks a box that feeds a model, which runs on three GPUs." width="1600" height="678" />
    <p class="one-liner" set:html={SITE.oneLiner} />
  </section>

  <section class="work">
    {SITE.work.map((w) => (
      <article class="work-item">
        <img src={w.img} alt="" loading="lazy" />
        <div>
          <h2>{w.title}</h2>
          <p>{w.text}</p>
          <p class="prs">{w.prs.map(([label, href]) => <a href={href}>{label}</a>)}</p>
        </div>
      </article>
    ))}
    <p class="more"><a href={allMergedUrl()}>All merged pull requests</a></p>
  </section>
</Base>
