---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
import { getPosts, fmtDate } from '../lib/posts.js';
import { getMergedPRs, repoName, allMergedUrl } from '../lib/oss.js';

const posts = await getPosts();
const prs = (await getMergedPRs()).slice(0, 8);
---
<Base>
  <section class="intro">
    {SITE.intro.map((p) => <p set:html={p} />)}
  </section>

  <section class="group">
    <h2 class="section-label">Writing</h2>
    {posts.length === 0 ? (
      <p class="muted">The first post is on its way. Follow along by <a href="/rss.xml">RSS</a>.</p>
    ) : (
      <ul class="entries posts">
        {posts.map((p) => (
          <li>
            <a href={`/posts/${p.id}/`}>
              <span class="entry-title">{p.data.title}{p.data.draft && <span class="badge">draft</span>}</span>
              <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
            </a>
            {p.data.description && <p class="entry-desc">{p.data.description}</p>}
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="group">
    <h2 class="section-label">Open source</h2>
    <ul class="entries oss">
      {prs.map((pr) => (
        <li>
          <a href={pr.url}>
            <span class="entry-title"><span class="repo">{repoName(pr.repo)}</span>{pr.title}</span>
            <time datetime={pr.merged.toISOString()}>{fmtDate(pr.merged, { month: 'short', year: 'numeric' })}</time>
          </a>
        </li>
      ))}
    </ul>
    <p class="more"><a href={allMergedUrl()}>All merged pull requests →</a></p>
  </section>
</Base>
