---
import Base from '../layouts/Base.astro';
import OssCard from '../components/OssCard.astro';
import { SITE } from '../site.js';
import { getMergedPRs, repoName, repoLogo, projectName, allMergedUrl } from '../lib/oss.js';
import { fmtDate } from '../lib/posts.js';

const merged = await getMergedPRs();
const repos = [...new Set(merged.map((p) => p.repo))];
---
<Base title="Open source" description="Devanshi Jain's open-source work on vLLM, PyTorch torchao and Humming: quantized inference, kernels and honest benchmarks.">
  <article class="page">
    <h1 class="page-title">Open source</h1>
    <p class="one-liner">Most of my open-source work is on quantized models: making them load, give the right answers, and run fast. The rest is kernels, and benchmarks that measure what they claim to.</p>

    <section class="block">
      <h2 class="label">Highlights</h2>
      <div class="oss-grid">
        {SITE.oss.map((item, i) => <OssCard item={{ ...item, eager: i < 2 }} />)}
      </div>
    </section>

    <section class="block">
      <h2 class="label">Full list</h2>
      {repos.map((r) => (
        <div class="repo-group">
          <h3 class="repo-head">
            {repoLogo(repoName(r)) && <img class="logo logo-lg" src={repoLogo(repoName(r))} alt="" width="112" height="112" />}
            <span>{projectName(repoName(r))}</span>
          </h3>
          <ul class="pr-list">
            {merged.filter((p) => p.repo === r).map((p) => (
              <li><a href={p.url}><span class="t">{p.title}</span><span class="n">#{p.number}</span><time datetime={p.merged.toISOString()}>{fmtDate(p.merged, { month: 'short', year: 'numeric' })}</time></a></li>
            ))}
          </ul>
        </div>
      ))}
      <p class="more"><a href={allMergedUrl()}>All pull requests on GitHub →</a></p>
    </section>

  </article>
</Base>
