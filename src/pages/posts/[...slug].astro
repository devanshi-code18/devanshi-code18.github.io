---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.js';
import { getPosts, fmtDate } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, draft } = post.data;
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(`/posts/${post.id}/`, SITE.url).href)}`;
---
<Base title={title} description={description || SITE.description} type="article" published={date}>
  <div class="container">
    <article class="post">
      <h1>{title}{draft && <span class="badge">draft</span>}</h1>
      <p class="info">Posted on {fmtDate(date)}{updated && <>, updated {fmtDate(updated)}</>}</p>
      <div class="prose">
        <Content />
      </div>
      <p class="post-end">
        <a href="/">← More posts</a>
        <span><a href={shareX}>Share on X</a> · <a href="/rss.xml">RSS</a></span>
      </p>
    </article>
  </div>
</Base>
