---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.js';
import { getPosts, fmtDate, readingMinutes, smart } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, draft } = post.data;
const url = new URL(`/posts/${post.id}/`, SITE.url).href;
const minutes = readingMinutes(post.body);
const words = (post.body || '').split(/\s+/).length;

// Contents only for long posts, and never listing the footnotes.
const toc = headings.filter((h) => (h.depth === 2 || h.depth === 3) && h.slug !== 'footnote-label');
const showToc = toc.filter((h) => h.depth === 2).length >= 3 && words >= 800;

// "Cite this post"
const parts = SITE.name.split(' ');
const last = parts.pop();
const author = `${last}, ${parts.join(' ')}`;
const month = date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const year = date.getUTCFullYear();
const key = `${last.toLowerCase()}${year}${post.id.split('-').slice(0, 2).join('')}`;
const host = new URL(SITE.url).host;
const bibtex = `@article{${key},
  title   = "${title}",
  author  = "${author}",
  journal = "${host}",
  year    = "${year}",
  month   = "${month}",
  url     = "${url}"
}`;
---
<Base title={smart(title)} description={smart(description) || SITE.description} type="article" published={date}>
  <article class="post">
    <header class="post-header">
      <h1>{smart(title)}{draft && <span class="badge">draft</span>}</h1>
      {description && <p class="post-dek">{smart(description)}</p>}
      <p class="post-meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        {minutes >= 5 && <><span aria-hidden="true"> · </span>{minutes} min read</>}
        {updated && <><span aria-hidden="true"> · </span>updated {fmtDate(updated)}</>}
      </p>
    </header>

    {showToc && (
      <details class="toc">
        <summary>Contents</summary>
        <ol>
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </details>
    )}

    <div class="prose">
      <Content />
    </div>

    <details class="cite">
      <summary>Cite this post</summary>
      <p>{author}. ({month} {year}). {title}. {host}. <a href={url}>{url}</a></p>
      <pre><code>{bibtex}</code></pre>
    </details>

    {(older || newer) && (
      <nav class="post-nav" aria-label="More posts">
        {older ? <a href={`/posts/${older.id}/`} class="older"><span class="k">« Older</span><span class="t">{smart(older.data.title)}</span></a> : <span />}
        {newer ? <a href={`/posts/${newer.id}/`} class="newer"><span class="k">Newer »</span><span class="t">{smart(newer.data.title)}</span></a> : <span />}
      </nav>
    )}
  </article>

  <script>
    // Copy buttons on code blocks.
    for (const pre of document.querySelectorAll('.prose pre, .cite pre')) {
      const box = document.createElement('div');
      box.className = 'code-box';
      pre.replaceWith(box);
      box.append(pre);
      const btn = document.createElement('button');
      btn.className = 'copy';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Select and copy';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      });
      box.append(btn);
    }

    // On wide screens, footnotes become notes in the right margin, next to the line
    // that refers to them. On narrow screens they stay at the end of the post.
    const prose = document.querySelector('.prose');
    const wide = window.matchMedia('(min-width: 76rem)');
    function placeNotes() {
      prose.querySelectorAll('.sidenote').forEach((n) => n.remove());
      const refs = [...prose.querySelectorAll('a[data-footnote-ref]')];
      document.body.classList.toggle('has-sidenotes', wide.matches && refs.length > 0);
      if (!wide.matches) return;
      const top0 = prose.getBoundingClientRect().top;
      let floor = 0;
      for (const ref of refs) {
        const item = document.getElementById(decodeURIComponent(ref.hash.slice(1)));
        if (!item) continue;
        const note = document.createElement('aside');
        note.className = 'sidenote';
        note.innerHTML = `<span class="n">${ref.textContent}</span>${item.innerHTML}`;
        note.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());
        prose.append(note);
        const top = Math.max(ref.getBoundingClientRect().top - top0 - 4, floor);
        note.style.top = `${top}px`;
        floor = top + note.offsetHeight + 12;
      }
    }
    placeNotes();
    wide.addEventListener('change', placeNotes);
    window.addEventListener('load', placeNotes);
    document.fonts?.ready.then(placeNotes);
    let t;
    window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(placeNotes, 150); });
  </script>
</Base>
