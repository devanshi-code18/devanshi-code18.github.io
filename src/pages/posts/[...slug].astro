---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.js';
import { getPosts, fmtDate, readingMinutes } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

const { post, newer, older } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, date, updated, draft } = post.data;
const url = new URL(`/posts/${post.id}/`, SITE.url).href;

// A contents box only for posts long enough to need one.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = toc.filter((h) => h.depth === 2).length >= 3;

// "Cite this post", for anyone who wants to reference it.
const [last, ...rest] = SITE.name.split(' ').reverse();
const author = `${last}, ${rest.reverse().join(' ')}`;
const month = date.toLocaleDateString('en-US', { month: 'short', timeZone: 'UTC' });
const year = date.getUTCFullYear();
const key = `${last.toLowerCase()}${year}${post.id.split('-').slice(0, 2).join('')}`;
const host = new URL(SITE.url).host;
const bibtex = `@article{${key},
  title   = "${title}",
  author  = "${author}",
  journal = "${host}",
  year    = "${year}",
  month   = "${month}",
  url     = "${url}"
}`;
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
---
<Base title={title} description={description || SITE.description} type="article" published={date}>
  <article class="post">
    <header class="post-header">
      <h1>{title}{draft && <span class="badge">draft</span>}</h1>
      <p class="post-meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        <span aria-hidden="true"> · </span>{readingMinutes(post.body)} min read
        {updated && <><span aria-hidden="true"> · </span>updated {fmtDate(updated)}</>}
      </p>
    </header>

    {showToc && (
      <details class="toc">
        <summary>Contents</summary>
        <ol>
          {toc.map((h) => <li class={`d${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </details>
    )}

    <div class="prose">
      <Content />
    </div>

    <details class="cite">
      <summary>Cite this post</summary>
      <p>{author}. ({month} {year}). {title}. {host}. <a href={url}>{url}</a></p>
      <pre><code>{bibtex}</code></pre>
    </details>

    <nav class="post-nav" aria-label="More posts">
      {older ? <a href={`/posts/${older.id}/`} class="older"><span>Older</span>{older.data.title}</a> : <span />}
      {newer ? <a href={`/posts/${newer.id}/`} class="newer"><span>Newer</span>{newer.data.title}</a> : <span />}
    </nav>

    <footer class="post-footer">
      <a href="/">← All posts</a>
      <span><a href={shareX}>Share on X</a><span aria-hidden="true"> · </span><a href="/rss.xml">RSS</a></span>
    </footer>
  </article>

  <script>
    // A copy button on every code block.
    for (const pre of document.querySelectorAll('.post pre')) {
      const btn = document.createElement('button');
      btn.className = 'copy';
      btn.type = 'button';
      btn.textContent = 'Copy';
      btn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector('code')?.innerText ?? pre.innerText);
          btn.textContent = 'Copied';
        } catch {
          btn.textContent = 'Press ⌘C';
        }
        setTimeout(() => (btn.textContent = 'Copy'), 1600);
      });
      const box = document.createElement('div');
      box.className = 'code-box';
      pre.replaceWith(box);
      box.append(pre, btn);
    }
  </script>
</Base>
