---
import { render } from 'astro:content';
import 'katex/dist/katex.min.css';
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.js';
import { getPosts, fmtDate, readingMinutes } from '../../lib/posts.js';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, draft } = post.data;
const shareX = `https://x.com/intent/post?text=${encodeURIComponent(title)}&url=${encodeURIComponent(new URL(`/posts/${post.id}/`, SITE.url).href)}`;
---
<Base title={title} description={description || SITE.description} type="article" published={date}>
  <article class="post">
    <header class="post-header">
      <p class="post-meta">
        <time datetime={date.toISOString()}>{fmtDate(date)}</time>
        <span aria-hidden="true"> · </span>{readingMinutes(post.body)} min read
        {updated && <><span aria-hidden="true"> · </span>updated {fmtDate(updated)}</>}
        {draft && <span class="badge">draft</span>}
      </p>
      <h1>{title}</h1>
      {description && <p class="post-dek">{description}</p>}
    </header>
    <div class="prose">
      <Content />
    </div>
    <footer class="post-footer">
      <a href="/">← All posts</a>
      <span><a href={shareX}>Share on X</a><span aria-hidden="true"> · </span><a href="/rss.xml">RSS</a></span>
    </footer>
  </article>
</Base>
