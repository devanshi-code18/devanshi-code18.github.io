---
import Base from '../../layouts/Base.astro';
import WritingList from '../../components/WritingList.astro';
import { getWriting } from '../../lib/writing.js';

const writing = await getWriting();
const years = [...new Set(writing.map((p) => p.date.getUTCFullYear()))];
---
<Base title="Writing" description="Writing by Devanshi Jain on ML inference systems. First post coming soon.">
  <article class="page">
    <h1 class="page-title">Writing</h1>
    {writing.length === 0 && (
      <>
        <img class="empty-art" src="/images/ink/writing.png" alt="An open notebook with a fountain pen that has just drawn one wavy line." width="720" height="480" />
        <p class="empty">First blog coming soon.</p>
      </>
    )}
    {years.map((y) => (
      <section class="group">
        <h2 class="section-label">{y}</h2>
        <WritingList items={writing.filter((p) => p.date.getUTCFullYear() === y)} />
      </section>
    ))}
  </article>
</Base>
