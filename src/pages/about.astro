---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
import { getMergedPRs, repoName, allMergedUrl } from '../lib/oss.js';
import { fmtDate } from '../lib/posts.js';

const prs = await getMergedPRs();
const handles = { GitHub: SITE.github, X: SITE.x, LinkedIn: 'djain18', 'Google Scholar': 'Devanshi Jain' };
---
<Base title="About" description={`About ${SITE.name}.`}>
  <article class="page">
    <h1 class="page-title">About</h1>
    <div class="prose">
      {SITE.about.map((p) => <p set:html={p} />)}
    </div>

    <section class="group">
      <h2 class="section-label">Elsewhere</h2>
      <ul class="elsewhere">
        {SITE.links.map((l) => <li><span class="k">{l.label}</span><a href={l.href}>{handles[l.label] || l.href}</a></li>)}
        <li><span class="k">RSS</span><a href="/rss.xml">{new URL('/rss.xml', SITE.url).host}/rss.xml</a></li>
      </ul>
    </section>

    <section class="group" id="open-source">
      <h2 class="section-label">Open source</h2>
      <ul class="oss">
        {prs.map((pr) => (
          <li>
            <a href={pr.url}>
              <span class="r">{repoName(pr.repo)}</span>
              <span class="t">{pr.title}</span>
              <span class="d">{fmtDate(pr.merged, { month: 'short', year: 'numeric' })}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="more"><a href={allMergedUrl()}>All merged pull requests on GitHub</a></p>
    </section>
  </article>
</Base>
