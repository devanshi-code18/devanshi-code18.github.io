---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
---
<Base title="About">
  <article class="page">
    <h1 class="page-title">About</h1>
    <div class="prose">
      {SITE.intro.map((p) => <p set:html={p} />)}
      <p>Here I write about what I learn making models run faster: serving engines, GPU kernels, quantization, and the measurements behind them. Views here are my own.</p>
    </div>
  </article>
</Base>
