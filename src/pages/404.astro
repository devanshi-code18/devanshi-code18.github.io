---
import Base from '../layouts/Base.astro';
import { getPosts, fmtDate, smart } from '../lib/posts.js';
const posts = (await getPosts()).slice(0, 3);
---
<Base title="Not found" noindex>
  <article class="page">
    <h1 class="page-title">Not found</h1>
    <div class="prose"><p>There’s nothing at this address. Try the <a href="/">home page</a> or <a href="/writing/">all writing</a>.</p></div>
    {posts.length > 0 && (
      <section class="group">
        <h2 class="section-label">Recent writing</h2>
        <ul class="posts">
          {posts.map((p) => (
            <li>
              <a href={`/posts/${p.id}/`}>
                <time datetime={p.data.date.toISOString()}>{fmtDate(p.data.date, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                <span class="title">{smart(p.data.title)}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</Base>
