---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
import CareerLine from '../components/CareerLine.astro';

const main = SITE.career.filter((c) => !c.earlier);
const earlier = SITE.career.filter((c) => c.earlier);
// Marks on the career line, oldest first: spaced partly by time and partly evenly, so close
// roles don't overlap. Older marks are open squares; recent ones fill in to solid ink.
const now = new Date(); const tNow = now.getUTCFullYear() + now.getUTCMonth() / 12;
const all = [
  ...earlier.map((c, k) => ({ c, row: `earlier-${k}` })),
  ...main.map((c, k) => ({ c, row: `role-${k}` })),
].sort((a, b) => a.c.start - b.c.start);
const tMin = all[0].c.start - 0.15, tMax = tNow + 0.2;
const mainOld = main.slice().sort((a, b) => a.start - b.start);
const stations = all.map(({ c, row }, i) => {
  const k = c.earlier ? -1 : mainOld.indexOf(c);
  const q = k < 0 ? 0 : Math.min(1, (k + 1) / 3);
  const size = k < 0 ? 5 : [6, 7.5, 9, 11][Math.min(3, k)]; // filled marks draw smaller, so they get more room
  const u = 0.35 * (c.start - tMin) / (tMax - tMin) + 0.65 * ((i + 0.5) / all.length) * 0.94;
  return { u: +u.toFixed(4), q: +q.toFixed(3), size, row };
});
const service = [
  { title: 'Reviewer', img: '/images/work/reviewer.png', alt: 'A stick figure checks a stack of papers with a magnifying glass.', items: SITE.reviewer.map((r) => ({ name: r.venue, href: r.href, what: r.what })) },
  { title: 'Hackathon judge', img: '/images/work/judge.png', alt: 'A stick figure holds up a scorecard in front of a proud team.', items: SITE.judge.map((r) => ({ name: r.venue, href: r.href, what: r.what })) },
  { title: 'Hackathon wins', img: '/images/work/wins.png', alt: 'A stick figure holds a trophy over their head.', items: SITE.wins.map((w) => ({ name: w.name, href: w.href, what: w.what })) },
];
---
<Base title="Work" description={`${SITE.name}: GPU inference savings for video ranking at Meta, Muse Spark post-training data, internships at Amazon and Meta, peer review and hackathons.`}>
  <article class="page">
    <h1 class="page-title">Work</h1>

    <CareerLine stations={stations} />

    <ol class="roles">
      {main.map((c, k) => (
        <li class="role" data-station={`role-${k}`} tabindex="-1">
          <p class="when">{c.dates}</p>
          <div class="role-text">
            <h2><span class="ink-hl">{c.role}<span class="sep"> · </span><span class="org">{c.org}</span><svg class="ink-ul" aria-hidden="true"><path pathLength="1" /></svg></span></h2>
            <p class="line" set:html={c.line} />
          </div>
        </li>
      ))}
    </ol>

    <section class="block">
      <h2 class="label">Service and awards</h2>
      <div class="three-col">
        {service.map((s) => (
          <div class="service-col">
            <img src={s.img} alt={s.alt} width="576" height="384" loading="lazy" />
            <h3 class="sublabel">{s.title}</h3>
            <ul class="service">
              {s.items.map((i) => <li>{i.href ? <a href={i.href}>{i.name}</a> : <strong>{i.name}</strong>}<span>{i.what}</span></li>)}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <section class="block">
      <h2 class="label">Earlier, at UC San Diego</h2>
      <ul class="earlier">
        {earlier.map((c, k) => (
          <li data-station={`earlier-${k}`}><span class="when">{c.dates}</span><span class="role-text">{c.href ? <a class="place ink-hl" href={c.href}>{c.org}<svg class="ink-ul" aria-hidden="true"><path pathLength="1" /></svg></a> : <strong class="place ink-hl">{c.org}<svg class="ink-ul" aria-hidden="true"><path pathLength="1" /></svg></strong>}<span class="sep"> · </span>{c.role}{c.note && <><span class="sep"> · </span><Fragment set:html={c.note} /></>}</span></li>
        ))}
      </ul>
    </section>
  </article>
</Base>

<script>
  // A quick scribbled pen underline under a role's title, drawn in when the role is lit
  // (resting the mouse on it, tapping it, or picking its mark on the career line).
  // One stroke out with a slight wobble, and a short return stroke under its end.
  const rnd = (n) => { const v = Math.sin(n * 127.1 + 311.7) * 43758.5453; return v - Math.floor(v) - 0.5; };
  function scribble(svg, seed) {
    const w = svg.clientWidth, h = svg.clientHeight;
    if (w < 4 || h < 4) return;
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    const y = h * 0.4, N = Math.max(4, Math.round(w / 40));
    let d = `M${(1 + rnd(seed) * 2).toFixed(1)} ${(y + rnd(seed + 1) * 1.5).toFixed(1)}`;
    for (let k = 1; k <= N; k++) {
      const x = (w - 2) * k / N, cx = (w - 2) * (k - 0.5) / N;
      d += `Q${cx.toFixed(1)} ${(y + (k % 2 ? 1 : -1) * (1.2 + rnd(seed + k) * 0.8)).toFixed(1)} ${x.toFixed(1)} ${(y + rnd(seed + 10 + k) * 0.9 + k * 0.08).toFixed(1)}`;
    }
    // the little return stroke, slightly lower, back under the last part
    const r0 = w - 4 - rnd(seed + 40) * 4, r1 = w * (0.5 + rnd(seed + 41) * 0.15);
    d += `M${r0.toFixed(1)} ${(h * 0.62).toFixed(1)}Q${((r0 + r1) / 2).toFixed(1)} ${(h * 0.95).toFixed(1)} ${r1.toFixed(1)} ${(h * 0.78).toFixed(1)}`;
    svg.firstElementChild.setAttribute('d', d);
  }
  const marks = [...document.querySelectorAll('.ink-ul')];
  const drawAll = () => marks.forEach((m, i) => scribble(m, i + 1));
  drawAll();
  if (window.ResizeObserver) { const ro = new ResizeObserver(drawAll); marks.forEach((m) => ro.observe(m)); }
  else window.addEventListener('resize', drawAll);
</script>
