---
import Base from '../layouts/Base.astro';
import { SITE } from '../site.js';
const byLabel = Object.fromEntries(SITE.links.map((l) => [l.label, l.href]));
---
<Base title="Contact">
  <article class="page">
    <h1 class="page-title">Contact</h1>
    <div class="prose">
      <p>The quickest way to reach me is a message on <a href={byLabel.X}>X ({SITE.x})</a> or <a href={byLabel.LinkedIn}>LinkedIn</a>.</p>
      {SITE.email && <p>Or email me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>}
      <p>Spotted a mistake in a post, or want to discuss one? Open an issue on <a href={`https://github.com/${SITE.github}/${SITE.github}.github.io/issues`}>this site's repository</a>.</p>
    </div>
  </article>
</Base>
