---
// A wordless ink figure from src/figures (drawn by scripts/ink-figures.mjs), inlined so it can
// play: it starts in its "before" state and plays into its "after" state when it scrolls into
// view; resting on it (or tapping it) plays it again. Without scripts, or with reduced motion,
// the "after" state shows.
const svgs = import.meta.glob('../figures/*.svg', { query: '?raw', import: 'default', eager: true });
const { name, label, class: cls = '' } = Astro.props;
const svg = svgs[`../figures/${name}.svg`];
if (!svg) throw new Error(`Missing figure: ${name}`);
---
<div class={`fig fig-${name} ${cls}`.trim()} role="img" aria-label={label} set:html={svg} />

<script>
  const figs = [...document.querySelectorAll('.fig')];
  if (figs.length && document.documentElement.classList.contains('figs-js')) {
    // .done drops the transitions once the play should be over, so a figure always lands on its
    // finished drawing even when the browser paused animations (Safari does in some views).
    const go = (el) => {
      el.classList.add('go'); el.dataset.t = String(performance.now());
      clearTimeout(el._done); el._done = setTimeout(() => el.classList.add('done'), 2400);
    };
    const replay = (el) => {
      el.classList.remove('go', 'done');
      void el.getBoundingClientRect();
      requestAnimationFrame(() => requestAnimationFrame(() => go(el)));
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        io.unobserve(e.target);
        setTimeout(() => go(e.target), 120);
      }), { threshold: 0.45 });
      figs.forEach((el) => io.observe(el));
    } else figs.forEach(go);
    figs.forEach((el) => el.addEventListener('pointerenter', () => {
      if (el.classList.contains('go') && performance.now() - Number(el.dataset.t || 0) > 2600) replay(el);
    }));
  }
</script>
