---
// Tiny hand-drawn ink icons for the phone tab bar. Strokes overshoot a little, like pen lines.
const { name } = Astro.props;
---
<svg class="tab-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'home' && (
    <>
      <path d="M3.3 3.6 L9.9 3.3 M9.7 3.1 L9.9 9.9 M10.1 9.7 L3.4 9.9 M3.6 10.2 L3.3 3.4" />
      <path d="M3.5 14.1 L9.8 13.9 M9.6 13.7 L9.9 20.4 M10.1 20.2 L3.5 20.5 M3.7 20.7 L3.4 13.9" />
      <path d="M14.1 14.2 L20.6 13.9 M20.4 13.7 L20.6 20.4 M20.8 20.2 L14.2 20.5 M14.4 20.7 L14.1 14" />
      <path d="M17.2 3.4 C19.3 3.3 20.6 4.8 20.5 6.8 C20.4 8.8 18.9 10 17.1 9.9 C15.2 9.8 13.9 8.4 14 6.5 C14.1 4.6 15.4 3.5 17.2 3.4 Z" fill="currentColor" stroke-width="1" />
    </>
  )}
  {name === 'work' && (
    <>
      <path d="M3.2 8.3 L20.9 8 M20.7 7.8 L20.8 19.8 M21 19.6 L3.3 19.9 M3.5 20.1 L3.2 8.1" />
      <path d="M9 8 C8.9 5.9 9.8 5 12 5 C14.2 5 15.1 5.9 15 8" />
      <path d="M3.4 13.2 L20.7 13" />
      <path d="M11.2 12.2 L12.9 12.1 L12.9 14.1 L11.2 14.2 Z" />
    </>
  )}
  {name === 'open-source' && (
    <>
      <path d="M6.4 3 C7.6 3 8.4 3.9 8.4 5 C8.4 6.1 7.5 7 6.4 7 C5.3 7 4.4 6.1 4.4 5 C4.4 3.9 5.3 3 6.4 3 Z" />
      <path d="M6.5 17 C7.6 17 8.5 17.9 8.5 19 C8.5 20.1 7.6 21 6.5 21 C5.4 21 4.5 20.1 4.5 19 C4.5 17.9 5.4 17 6.5 17 Z" />
      <path d="M17.6 6 C18.7 6 19.6 6.9 19.6 8 C19.6 9.1 18.7 10 17.6 10 C16.5 10 15.6 9.1 15.6 8 C15.6 6.9 16.5 6 17.6 6 Z" />
      <path d="M6.4 7.2 L6.6 16.8" />
      <path d="M17.5 10.2 C17.4 14.2 14.6 15.8 8.4 17.2" />
    </>
  )}
  {name === 'writing' && (
    <>
      <path d="M4.2 19.8 L5.3 15.7 L15.8 5.2 C16.6 4.4 17.9 4.4 18.7 5.2 C19.5 6 19.5 7.3 18.7 8.1 L8.2 18.6 Z" />
      <path d="M14.3 6.8 L17.1 9.6" />
      <path d="M12.2 20.4 C13.6 19.5 14.6 19.4 15.6 20.2 C16.5 20.9 17.6 20.9 19.8 19.6" />
    </>
  )}
</svg>
