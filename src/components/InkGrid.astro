---
// The home page's main visual: a hand-inked weight matrix. Touch it and the weights
// near the pointer get "quantized" (2-bit: four drawn states) from open pen squares into
// solid ink blobs, then relax back as hollow rings, leaving a small trail. A ghost
// pointer wanders when nobody is touching it. A tap sends an ink ripple across the grid;
// press and drag to draw marks that stay solid for a few seconds. Black ink only, no words.
// If scripts don't run, a still picture of the grid shows instead (CSS background).
---
<div class="ink-grid" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  const root = document.querySelector('.ink-grid');
  const cv = root?.querySelector('canvas');
  const g = cv && cv.getContext ? cv.getContext('2d') : null;
  if (g) {
    const P = {
      cell: 28, cellPhone: 24, half: 0.3, lw: 1.4, lwVar: 0.15, wob: 1.1, rot: 3, sizeVar: 0.06,
      over: 1.6, bow: 0.6, radMin: 70, radMax: 130, radK: 0.13, attack: 0.012, relax: 0.00055,
      boilMs: 160, boilN: 3, levels: 3, fillAt: 0.5, stick: 0.03, idleMs: 2500, mineRelax: 0.5,
      rippleSpeed: 0.36, rippleBand: 0.9, paintR: 0.8, paintMs: 6000,
    };
    const reduced = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
    let W = 0, H = 0, o = 28, cols = 0, rows = 0, x0 = 0, y0 = 0, inset = 0, boil = 1;
    let d = new Float32Array(0), dir = new Int8Array(0), hold = new Float64Array(0), mine = new Uint8Array(0), rip = new Float32Array(0);
    const ptr = { x: 0, y: 0, last: -1e9, t: 0, vx: 0, vy: 0 };
    let ph = Math.random() * 100, gx = -1e4, gy = -1e4, wasGhost = true;
    // taps send out an ink ripple; press-and-drag paints marks that stay solid for a while
    const ripples = [];
    const pen = { down: false, at: 0, x: 0, y: 0, px: 0, py: 0, moved: 0 };

    // Deterministic noise: `h` changes with each ink "boil" frame, `hs` never changes.
    const hb = (e, t, f) => { const n = Math.sin(e * 127.1 + t * 311.7 + f * 74.7) * 43758.5453; return n - Math.floor(n) - 0.5; };
    const h = (e, t) => hb(e, t, boil);
    const hs = (e, t) => hb(e, t, 0);

    // Measure the box. Returns false while it has no size yet (we try again later).
    function layout() {
      const w = root.clientWidth, hh = root.clientHeight;
      if (w < 10 || hh < 10) return false;
      if (Math.abs(w - W) < 1 && Math.abs(hh - H) < 1 && cols > 0) return true;
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      W = w; H = hh;
      cv.width = Math.round(W * dpr); cv.height = Math.round(H * dpr);
      g.setTransform(dpr, 0, 0, dpr, 0, 0);
      o = W < 520 ? P.cellPhone : P.cell;
      inset = Math.max(14, o * 0.7);
      cols = Math.max(1, Math.floor((W - 2 * inset) / o)); rows = Math.max(1, Math.floor(H / o));
      x0 = (W - cols * o) / 2 + o / 2; y0 = (H - rows * o) / 2 + o / 2;
      d = new Float32Array(cols * rows); dir = new Int8Array(cols * rows); hold = new Float64Array(cols * rows); mine = new Uint8Array(cols * rows); rip = new Float32Array(cols * rows);
      if (reduced) seedStill();
      root.classList.add('live');
      return true;
    }

    // One side of a hand-drawn square: a slightly bowed pen stroke that overshoots its corner.
    function strokeSeg(ax, ay, bx, by, i, s) {
      const dx = bx - ax, dy = by - ay, L = Math.sqrt(dx * dx + dy * dy) || 1, ux = dx / L, uy = dy / L;
      const o0 = P.over * (0.5 + hs(i, 50 + s)), o1 = P.over * (0.2 + hs(i, 60 + s) * 0.8);
      const sx = ax - ux * o0 * 0.3, sy = ay - uy * o0 * 0.3, ex = bx + ux * o1, ey = by + uy * o1;
      const b = P.bow * (hs(i, 70 + s) * 2) + h(i, 80 + s) * P.wob * 0.5;
      g.moveTo(sx, sy);
      g.quadraticCurveTo((sx + ex) / 2 - uy * b, (sy + ey) / 2 + ux * b, ex, ey);
    }

    // A wobbly shape between a square (q = 0) and a circle (q = 1).
    function shape(cx, cy, t, q, i, rotA) {
      const N = 20, pts = [], ca = Math.cos(rotA), sa = Math.sin(rotA);
      for (let k = 0; k < N; k++) {
        const a = (k / N) * Math.PI * 2 + Math.PI / 4;
        const sq = 1 / Math.max(Math.abs(Math.cos(a)), Math.abs(Math.sin(a)));
        const rr = t * ((1 - q) * sq + q) + h(i, 100 + k) * P.wob * 0.9;
        const px = Math.cos(a) * rr, py = Math.sin(a) * rr;
        pts.push([cx + px * ca - py * sa, cy + px * sa + py * ca]);
      }
      return pts;
    }

    function draw() {
      if (!cols) return;
      g.clearRect(0, 0, W, H);
      g.lineJoin = 'round'; g.lineCap = 'round'; g.strokeStyle = '#111'; g.fillStyle = '#111';
      const e = o * P.half, now = performance.now();
      for (let rr = 0; rr < rows; rr++) for (let cc = 0; cc < cols; cc++) {
        const i = rr * cols + cc;
        const cx = x0 + cc * o + h(i, 1) * 0.9, cy = y0 + rr * o + h(i, 2) * 0.9;
        g.lineWidth = P.lw + hs(i, 90) * 2 * P.lwVar;
        const ee = e * (1 + hs(i, 91) * 2 * P.sizeVar);
        const rotA = (hs(i, 92) * 2 * P.rot * Math.PI) / 180;
        const fromRip = rip[i] > d[i];
        const q = Math.round(Math.max(d[i], rip[i]) * P.levels) / P.levels; // 2-bit: four drawn states
        if (q <= 0) {
          const ca = Math.cos(rotA), sa = Math.sin(rotA), w = P.wob;
          const C = [[-1, -1], [1, -1], [1, 1], [-1, 1]].map(([sx, sy], k) => {
            const px = sx * ee + hs(i, 3 + 2 * k) * w * 1.2 + h(i, 3 + 2 * k) * w;
            const py = sy * ee + hs(i, 4 + 2 * k) * w * 1.2 + h(i, 4 + 2 * k) * w;
            return [cx + px * ca - py * sa, cy + px * sa + py * ca];
          });
          g.beginPath();
          for (let s = 0; s < 4; s++) strokeSeg(C[s][0], C[s][1], C[(s + 1) % 4][0], C[(s + 1) % 4][1], i, s);
          g.stroke();
          continue;
        }
        const t = ee * (mine[i] === 2 && hold[i] > now ? 0.82 : 1 - 0.45 * q); // painted marks draw as full blobs
        const pts = shape(cx, cy, t, Math.min(1, q * 1.1), i, rotA);
        g.beginPath(); g.moveTo(pts[0][0], pts[0][1]);
        for (let k = 1; k < pts.length; k++) g.lineTo(pts[k][0], pts[k][1]);
        g.closePath();
        const relaxing = !fromRip && dir[i] < 0 && hold[i] < now;
        if (relaxing || q < P.fillAt) { g.stroke(); continue; } // hollow rings: the trail
        g.fill(); g.stroke();
      }
      // Hand-drawn matrix brackets, so the grid reads as a matrix of weights.
      const L = x0 - o / 2 - inset * 0.55, R = x0 + (cols - 0.5) * o + inset * 0.55;
      const T = y0 - o / 2 + 2, B = y0 + (rows - 0.5) * o - 2, s = Math.min(10, inset * 0.6);
      const j = (k) => h(999, k) * P.wob;
      g.lineWidth = P.lw * 1.35; g.beginPath();
      g.moveTo(L + s + j(1), T + j(2)); g.lineTo(L + j(3), T + 1 + j(4)); g.quadraticCurveTo(L - 1.5 + j(5), (T + B) / 2, L + j(6), B - 1 + j(7)); g.lineTo(L + s + j(8), B + j(9));
      g.moveTo(R - s + j(11), T + j(12)); g.lineTo(R + j(13), T + 1 + j(14)); g.quadraticCurveTo(R + 1.5 + j(15), (T + B) / 2, R + j(16), B - 1 + j(17)); g.lineTo(R - s + j(18), B + j(19));
      g.stroke();
    }

    // Where on its path the ghost should pick up: the point nearest where the person let go,
    // heading the way they were moving, so it carries on from their mark instead of jumping.
    const path = (p) => [W * (0.5 + 0.42 * Math.sin(p * 1.3)), H * (0.5 + 0.38 * Math.sin(p * 2.1 + 1.2))];
    function pickPhase() {
      const sp = Math.hypot(ptr.vx, ptr.vy);
      let best = ph, bc = Infinity;
      for (let k = 0; k < 4000; k++) {
        const p = ph + k * 0.01, [px, py] = path(p);
        let c = (px - ptr.x) ** 2 + (py - ptr.y) ** 2;
        if (sp > 0.02) {
          const dx = W * 0.546 * Math.cos(p * 1.3), dy = H * 0.798 * Math.cos(p * 2.1 + 1.2), dl = Math.hypot(dx, dy) || 1;
          c += (1 - (dx * ptr.vx + dy * ptr.vy) / (dl * sp)) * W * W * 0.004;
        }
        if (c < bc) { bc = c; best = p; }
      }
      return best;
    }

    function step(dt) {
      const now = performance.now();
      let tx = ptr.x, ty = ptr.y;
      const ghost = now - ptr.last > P.idleMs;
      if (ghost && !wasGhost) ph = pickPhase();
      wasGhost = ghost;
      if (ghost) {
        ph += dt * 3.5e-4;
        tx = W * (0.5 + 0.42 * Math.sin(ph * 1.3)); ty = H * (0.5 + 0.38 * Math.sin(ph * 2.1 + 1.2));
      }
      // The ghost eases in from wherever the finger or cursor was; the real one is followed directly.
      if (gx < -1e3) { gx = tx; gy = ty; }
      const k = ghost ? Math.min(1, dt * 0.003) : 1;
      gx += (tx - gx) * k; gy += (ty - gy) * k;
      const R = Math.max(P.radMin, Math.min(P.radMax, W * P.radK));
      // ripples: a ring of ink that spreads out from a tap, solid at its front with a short
      // trail of rings behind, fading as it grows. Drawn on top of the weights, not stored in them.
      const band = o * P.rippleBand, far = Math.hypot(W, H) * 0.75;
      rip.fill(0);
      for (let k = ripples.length - 1; k >= 0; k--) {
        const rp = ripples[k], r = (now - rp.t0) * P.rippleSpeed;
        if (r > far + band * 2) { ripples.splice(k, 1); continue; }
        const amp = Math.max(0, 1 - r / far);
        for (let i = 0; i < cols * rows; i++) {
          const cx = x0 + (i % cols) * o, cy = y0 + Math.floor(i / cols) * o;
          const dd = Math.hypot(cx - rp.x, cy - rp.y) - r;
          const a = (dd > 0 ? 1 - dd / (band * 0.6) : 1 + dd / (band * 1.8)) * amp;
          if (a > rip[i]) rip[i] = a;
        }
      }
      // painting: cells along the pen's path go solid and stay that way for a while
      if (pen.down && pen.moved > 6) {
        const ax = pen.px, ay = pen.py, bx = ptr.x, by = ptr.y, sx = bx - ax, sy = by - ay, L2 = sx * sx + sy * sy || 1;
        for (let i = 0; i < cols * rows; i++) {
          const cx = x0 + (i % cols) * o, cy = y0 + Math.floor(i / cols) * o;
          const t = Math.max(0, Math.min(1, ((cx - ax) * sx + (cy - ay) * sy) / L2));
          if (Math.hypot(cx - ax - sx * t, cy - ay - sy * t) < o * P.paintR) {
            d[i] = 1; dir[i] = 1; mine[i] = 2; hold[i] = Math.max(hold[i], now + P.paintMs + (hs(i, 35) + 0.5) * 2000);
          }
        }
        pen.px = bx; pen.py = by;
      }
      for (let rr = 0; rr < rows; rr++) for (let cc = 0; cc < cols; cc++) {
        const i = rr * cols + cc, dx = x0 + cc * o - gx, dy = y0 + rr * o - gy;
        const tgt = Math.max(0, 1 - Math.sqrt(dx * dx + dy * dy) / R), cur = d[i];
        if (tgt > cur) {
          d[i] = cur + (tgt - cur) * Math.min(1, dt * P.attack); dir[i] = 1;
          if (!ghost && mine[i] !== 2) mine[i] = 1; // marks the person made fade more slowly
          if (cur < 0.9 && d[i] >= 0.9 && hs(i, 33) + 0.5 < P.stick) hold[i] = now + 2500 + (hs(i, 34) + 0.5) * 4000;
        } else if (hold[i] > now) d[i] = Math.max(cur, 1);
        else {
          const nv = cur - Math.min(cur, dt * P.relax * (mine[i] ? P.mineRelax : 1));
          if (nv < cur) dir[i] = -1;
          if (nv <= 0) mine[i] = 0;
          d[i] = nv;
        }
      }
    }

    // Reduced motion: one still picture, a diagonal band of quantized weights.
    function seedStill() {
      for (let rr = 0; rr < rows; rr++) for (let cc = 0; cc < cols; cc++) {
        const n = Math.abs(cc / cols - 0.5 - (rr / rows - 0.5) * 0.6);
        d[rr * cols + cc] = Math.max(0, 1 - n * 5);
      }
    }

    // Finger or cursor. A touch keeps its spot for a moment after lifting, so taps show too.
    const mv = (ev) => {
      const r = cv.getBoundingClientRect();
      const t = performance.now(), x = ev.clientX - r.left, y = ev.clientY - r.top;
      if (ptr.t && t - ptr.t < 200) { const dt = Math.max(8, t - ptr.t); ptr.vx = ptr.vx * 0.6 + ((x - ptr.x) / dt) * 0.4; ptr.vy = ptr.vy * 0.6 + ((y - ptr.y) / dt) * 0.4; }
      else { ptr.vx = 0; ptr.vy = 0; }
      ptr.x = x; ptr.y = y; ptr.t = t; ptr.last = t;
      if (gx < -1e3 || ev.type === 'pointerdown') { gx = ptr.x; gy = ptr.y; }
      if (!running && !reduced) start();
    };
    cv.addEventListener('pointermove', (ev) => {
      mv(ev);
      if (pen.down) pen.moved += Math.hypot(ptr.x - pen.x, ptr.y - pen.y), pen.x = ptr.x, pen.y = ptr.y;
    });
    cv.addEventListener('pointerdown', (ev) => {
      mv(ev);
      Object.assign(pen, { down: true, at: performance.now(), x: ptr.x, y: ptr.y, px: ptr.x, py: ptr.y, moved: 0 });
      try { cv.setPointerCapture(ev.pointerId); } catch (e) {}
    });
    const lift = (ev) => {
      if (!pen.down) return;
      pen.down = false;
      // a quick tap (not a drag) sends out a ripple
      if (ev.type === 'pointerup' && pen.moved < 8 && performance.now() - pen.at < 400 && !reduced) {
        ripples.push({ x: ptr.x, y: ptr.y, t0: performance.now() });
        if (ripples.length > 4) ripples.shift();
        ptr.last = performance.now();
        if (!running) start();
      }
    };
    cv.addEventListener('pointerup', lift);
    cv.addEventListener('pointercancel', lift);
    cv.addEventListener('pointerleave', (ev) => { lift(ev); if (ev.pointerType === 'mouse') ptr.last = performance.now() - P.idleMs + 400; });

    let last = 0, lastBoil = 0, running = false, onScreen = true;
    function frame(t) {
      if (!running) return;
      if (!cols && !layout()) { requestAnimationFrame(frame); return; }
      const dt = last ? Math.max(0, Math.min(64, t - last)) : 16; last = t;
      step(dt);
      if (t - lastBoil > P.boilMs) { boil = (boil % P.boilN) + 1; lastBoil = t; }
      draw();
      requestAnimationFrame(frame);
    }
    function start() { if (running || reduced) return; running = true; last = 0; requestAnimationFrame(frame); }
    function stop() { running = false; }
    const refresh = () => { if (layout()) draw(); };

    // Size changes of the box itself (fonts, rotation, the phone's address bar), not just the window.
    if (window.ResizeObserver) new ResizeObserver(refresh).observe(root);
    window.addEventListener('resize', refresh);
    window.addEventListener('load', refresh);
    window.addEventListener('pageshow', () => { refresh(); if (onScreen && !document.hidden) start(); });
    document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else if (onScreen) start(); });
    if (window.IntersectionObserver) {
      new IntersectionObserver(([en]) => { onScreen = en.isIntersecting; if (onScreen && !document.hidden) start(); else stop(); }).observe(root);
    }
    refresh();
    if (!reduced) start();
    else requestAnimationFrame(refresh);
  }
</script>
