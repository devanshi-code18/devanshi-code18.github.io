---
import { fmtDate, smart } from '../lib/posts.js';
const { items } = Astro.props;
---
<ul class="posts">
  {items.map((p) => (
    <li>
      <a href={p.url}>
        <time datetime={p.date.toISOString()}>{fmtDate(p.date, { month: 'short', day: 'numeric', year: 'numeric' })}</time>
        <span class="title">{smart(p.title)}</span>{p.draft && <span class="badge">draft</span>}{p.external && <span class="ext" aria-label="on Substack"> ↗</span>}
        {p.description && <span class="desc">{smart(p.description)}</span>}
      </a>
    </li>
  ))}
</ul>
