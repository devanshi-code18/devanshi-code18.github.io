---
// A cover picture for a post card. Uses the post's own picture if it has one,
// otherwise draws flowing lines that are unique to the post (seeded by its URL).
const { seed = 'post', src, alt = '' } = Astro.props;

function hash(s) {
  let h = 2166136261;
  for (const c of s) { h ^= c.charCodeAt(0); h = Math.imul(h, 16777619); }
  return h >>> 0;
}
function rng(a) {
  return () => { a |= 0; a = (a + 0x6d2b79f5) | 0; let t = Math.imul(a ^ (a >>> 15), 1 | a); t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t; return ((t ^ (t >>> 14)) >>> 0) / 4294967296; };
}
const palettes = [
  ['#9b3b22', '#d0703f', '#e9b07a', '#2f4858'],
  ['#2f4858', '#33658a', '#86bbd8', '#d0703f'],
  ['#5b3a6e', '#9b3b22', '#e9b07a', '#33658a'],
  ['#1f5f5b', '#5aa38f', '#e9b07a', '#9b3b22'],
];
const r = rng(hash(seed));
const pal = palettes[Math.floor(r() * palettes.length)];
const W = 400, H = 225;
const lines = Array.from({ length: 7 }, (_, i) => {
  const base = 40 + (i * (H - 70)) / 6 + (r() - 0.5) * 18;
  const amp = 10 + r() * 34;
  const freq = (0.6 + r() * 1.6) * (Math.PI * 2) / W;
  const phase = r() * Math.PI * 2;
  const pts = [];
  for (let x = -10; x <= W + 10; x += 10) pts.push(`${x},${(base + amp * Math.sin(freq * x + phase) + amp * 0.35 * Math.sin(freq * 2.3 * x + phase * 1.7)).toFixed(1)}`);
  return { d: `M${pts.join(' L')}`, color: pal[i % pal.length], width: (1.5 + r() * 4.5).toFixed(1), opacity: (0.55 + r() * 0.4).toFixed(2) };
});
---
{src ? (
  <img class="cover" src={src} alt={alt} loading="lazy" />
) : (
  <svg class="cover" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <rect width={W} height={H} class="cover-bg" />
    {lines.map((l) => <path d={l.d} fill="none" stroke={l.color} stroke-width={l.width} stroke-linecap="round" opacity={l.opacity} />)}
  </svg>
)}
