---
import '../styles/global.css';
import { SITE } from '../site.js';
import TabIcon from '../components/TabIcon.astro';

const { title, description = SITE.description, type = 'website', published, home = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/og.png', SITE.url).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home', icon: 'home', current: path === '/' },
  { href: '/work/', label: 'Work', icon: 'work', current: path.startsWith('/work') },
  { href: '/open-source/', label: 'Open source', icon: 'open-source', current: path.startsWith('/open-source') },
  { href: '/writing/', label: 'Writing', icon: 'writing', current: path.startsWith('/writing') || path.startsWith('/posts/') },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name}: a hand-drawn sketch of a small GPU outrunning a cart of GPUs`} />
    <meta name="twitter:image:alt" content={`${SITE.name}: a hand-drawn sketch of a small GPU outrunning a cart of GPUs`} />
    <meta property="og:site_name" content={SITE.name} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content={SITE.x} />
    <meta name="author" content={SITE.name} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap">
        <nav class="site-nav" aria-label="Site">
          {nav.map((n) => <a href={n.href} aria-current={n.current ? 'page' : undefined}><TabIcon name={n.icon} /><span>{n.label}</span></a>)}
        </nav>
      </div>
    </header>
    <main class="wrap" id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <span class="footer-links">
          {SITE.links.filter((l) => l.label !== 'Google Scholar').map((l) => <a href={l.href}>{l.label}</a>)}
        </span>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const h = document.querySelector('.site-header');
        const f = () => h && h.classList.toggle('scrolled', window.scrollY > 4);
        addEventListener('scroll', f, { passive: true });
        f();
      })();
    </script>
  </body>
</html>
